@model PlacementTracker.Models.Application
@{
    ViewData["Title"] = $"{Model.Company} - {Model.Role}";
}

<h1>@Model.Company &mdash; @Model.Role</h1>

<section class="card">
    <dl class="detail-list">
        <dt>ID</dt>
        <dd>@Model.Id</dd>

        <dt>Company</dt>
        <dd>@Model.Company</dd>

        <dt>Role</dt>
        <dd>@Model.Role</dd>

        <dt>Status</dt>
        <dd><span class="badge badge-@Model.Status.ToLower()">@Model.Status</span></dd>

        <dt>Applied Date</dt>
        <dd>@(Model.AppliedOn.HasValue ? Model.AppliedOn.Value.ToString("dd MMM yyyy") : "-")</dd>

        <dt>Job URL</dt>
        <dd>
            @if (!string.IsNullOrWhiteSpace(Model.JobUrl))
            {
                <a href="@Model.JobUrl" target="_blank" rel="noopener">@Model.JobUrl</a>
            }
            else
            {
                <span>-</span>
            }
        </dd>

        <dt>Notes</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>

        <dt>Created At</dt>
        <dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
    </dl>

    <div class="button-row">
        <a class="btn" href="/">Back to dashboard</a>
        <a class="btn btn-primary" href="/applications/@Model.Id/edit">Edit</a>
        <form action="/applications/@Model.Id/delete" method="post" class="inline-form"
              onsubmit="return confirm('Delete this application? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</section>
