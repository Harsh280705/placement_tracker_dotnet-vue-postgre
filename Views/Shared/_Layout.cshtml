<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Placement Tracker</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav" aria-label="Main navigation">
            <a class="brand" href="/">Placement Tracker</a>
            <div class="nav-links">
                <a href="/">Dashboard</a>
                <a href="/applications/new" class="btn btn-primary">+ Add Application</a>
            </div>
        </nav>
    </header>
    <main class="container" role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>Placement Tracker &mdash; track job &amp; internship applications.</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
